# Docker Compose Environment Variables
# Copy this to .env and customize for your deployment

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend Settings
DEBUG=false
DEFAULT_WAREHOUSE=Stores - Company
DEFAULT_COMPANY=Your Company
DEFAULT_CURRENCY=USD

# Note: ERPNext connection is configured via the web UI after startup
# The app will prompt you to enter ERPNext URL and API credentials
